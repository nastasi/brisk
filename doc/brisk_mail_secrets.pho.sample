<?php
// place this file in Etc folder without '.sample' and
// set properly permessions (0620) and ownership (<user>:www-data)
// to configure mailserver secrets properly

use PHPMailer\PHPMailer\PHPMailer;
use PHPMailer\PHPMailer\Exception as PHPMailerException;

function mail_secrets($mail)
{
    $mail->isSMTP();
    $mail->Host = '<smtp hostname>';
    $mail->SMTPAuth = true;
    $mail->SMTPSecure= PHPMailer::ENCRYPTION_STARTTLS;
    $mail->Port = <port>;

    $mail->Username = '<username>';
    $mail->Password = '<password>';

    return;
}
?>
