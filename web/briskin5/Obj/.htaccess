# apache 2.4 (debian 13). The old 2.2 syntax "Order Deny,Allow / Deny from All"
# needs mod_access_compat, which is not guaranteed: the native one is used here,
# with a fallback.
<IfModule mod_authz_core.c>
    Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
    Order Deny,Allow
    Deny from All
</IfModule>
