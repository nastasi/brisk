/* page after the click on the link of the e-mail (mailmgr.php) */
function isc_page_activated($nick)
{
    header('Content-Type: text/html; charset=UTF-8');
    header('Cache-Control: no-store, max-age=0');
?><!doctype html>
<html lang="it"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1">
<title>Attiva il tuo account</title><?php isc_style(); ?><style>body{font-size:20px}h1{font-size:25px}</style></head><body><div class="box">
<div class="logo"><img src="img/brisk_logo64.png" alt="BRISK"></div>
  <h1>Account attivato! &#127881;</h1>
  <div class="ok" style="text-align:center;font-size:21px">Benvenuto <b><?php echo isc_h($nick); ?></b>, ora puoi giocare.</div>
  <p>Tocca il bottone qui sotto ed entra con il tuo nome e la tua password (li trovi anche nell'email).</p>
  <p>Quando il browser chiede <b>«Vuoi salvare la password?»</b> tocca <b>Salva</b>: la prossima volta entri da solo.</p>
  <a class="btn blu" href="index.php?n=<?php echo rawurlencode($nick); ?>">Entra a giocare</a>
</div></body></html>
<?php
}

