/*
 *  Common functions of the easy signup ("Crea il tuo account"):
 *  iscriviti.php, nickreq.php, mailmgr.php, password_dimenticata.php,
 *  password_nuova.php.
 */

define('ISC_ACCENTS', 'àáèéìíòóùúÀÁÈÉÌÍÒÓÙÚ');

/* the same time zone of the other pages (dates in the e-mails) */
date_default_timezone_set('Europe/Rome');

function isc_h($s)
{
    return htmlspecialchars((string)$s, ENT_QUOTES, 'UTF-8');
}

function isc_lower($n)
{
    return mb_strtolower((string)$n, 'UTF-8');
}

function isc_no_accents($n)
{
    return strtr(isc_lower($n), array('à' => 'a', 'á' => 'a', 'è' => 'e', 'é' => 'e', 'ì' => 'i',
                                      'í' => 'i', 'ò' => 'o', 'ó' => 'o', 'ù' => 'u', 'ú' => 'u'));
}

/* 2-12 letters (also the accented italian vowels) or digits */
function isc_nick_shape($n)
{
    return (preg_match('/^[A-Za-z0-9' . ISC_ACCENTS . ']{2,12}$/uD', $n) === 1);
}

/* clearly offensive words, anywhere in the nickname (digits read as letters, doubles removed) */
function isc_nick_forbidden($n)
{
    $s = strtr(isc_no_accents($n), array('0' => 'o', '1' => 'i', '3' => 'e', '4' => 'a', '5' => 's',
                                         '7' => 't', '8' => 'b', '9' => 'g'));
    $s2 = preg_replace('/(.)\1+/', '$1', $s);
    $v = array('cazz', 'merd', 'troia', 'puttan', 'stronz', 'vaffa', 'fanculo', 'minchi', 'coglion', 'diocan',
               'dioporc', 'porcodio', 'porcamadonn', 'madonnaputt', 'froci', 'ricchion', 'hitler', 'mussolin',
               'porno', 'fuck', 'shit', 'bitch', 'suca', 'bocchin', 'pompin', 'zoccol', 'mignott', 'inculo',
               'admin', 'amministra', 'staff', 'moderat', 'briskserv', 'nickserv', 'assistenza');
    foreach ($v as $p) {
        if (strpos($s, $p) !== FALSE || strpos($s2, $p) !== FALSE)
            return TRUE;
    }
    return FALSE;
}

/* nickname check: array(state 'ok'|'no', message, suggestion) */
function isc_nick_check($bdb, $n)
{
    $n = trim((string)$n);
    if ($n == "")
        return array('no', "Scrivi il nome che vuoi usare.", "");
    if (mb_strlen($n, 'UTF-8') < 2)
        return array('no', "Il nome deve avere almeno 2 caratteri.", "");
    if (mb_strlen($n, 'UTF-8') > 12)
        return array('no', "Il nome puo' avere al massimo 12 caratteri.", "");
    if (!preg_match('/^[A-Za-z0-9' . ISC_ACCENTS . ']+$/uD', $n))
        return array('no', "Usa solo lettere (anche accentate, come ò) e numeri, senza spazi o simboli.", "");
    if (isc_nick_forbidden($n))
        return array('no', "Questo nome non e' permesso. Scegline un altro.", "");
    if ($bdb->nick_is_free($n) == FALSE) {
        $sug = "";
        for ($i = 1 ; $i < 100 && $sug == "" ; $i++) {
            $p = mb_substr(isc_lower($n), 0, 12 - strlen((string)$i), 'UTF-8') . $i;
            if (isc_nick_shape($p) && $bdb->nick_is_free($p))
                $sug = $p;
        }
        return array('no', "Questo nome e' gia' usato da un altro giocatore.", $sug);
    }
    return array('ok', "Nome libero", "");
}

/* common typing errors in the e-mail domain */
function isc_mail_suggest($e)
{
    $e = strtolower(trim((string)$e));
    if (($at = strrpos($e, '@')) === FALSE)
        return "";
    $d = substr($e, $at + 1);
    $right = array('gmial.com' => 'gmail.com', 'gmai.com' => 'gmail.com', 'gamil.com' => 'gmail.com',
                   'gmil.com' => 'gmail.com', 'gnail.com' => 'gmail.com', 'gmail.it' => 'gmail.com',
                   'gmail.con' => 'gmail.com', 'hotmial.com' => 'hotmail.com', 'hotmal.it' => 'hotmail.it',
                   'hotmai.it' => 'hotmail.it', 'libreo.it' => 'libero.it', 'liberi.it' => 'libero.it',
                   'yaho.it' => 'yahoo.it', 'yahho.it' => 'yahoo.it', 'tiscalli.it' => 'tiscali.it',
                   'alcie.it' => 'alice.it', 'virgillio.it' => 'virgilio.it', 'outlok.it' => 'outlook.it',
                   'outlook.con' => 'outlook.com');
    return (isset($right[$d]) ? substr($e, 0, $at + 1) . $right[$d] : "");
}

function isc_mail_ok($e)
{
    return (filter_var((string)$e, FILTER_VALIDATE_EMAIL) !== FALSE && strlen((string)$e) <= 120);
}

/* signups never confirmed: after 48 hours account and mail go away, so nickname and e-mail are free again */
function isc_clean_expired($bdb)
{
    GLOBAL $G_dbpfx;

    $del_sql = sprintf("DELETE FROM %susers WHERE (type & (CAST (X'%08x' as integer))) = (CAST (X'%08x' as integer))
                            AND (type & (CAST (X'%08x' as integer))) = (CAST (X'%08x' as integer))
                            AND disa_reas = %d AND lintm < now() - interval '48 hours';",
                       $G_dbpfx, USER_FLAG_TY_DISABLE, USER_FLAG_TY_DISABLE,
                       USER_FLAG_TY_NICKTMP, USER_FLAG_TY_NICKTMP, USER_DIS_REA_NU_MAILED);
    $bdb->query($del_sql);
}

/* brisk_mail() builds the text version of an e-mail from the html, keeping only
   its real line breaks: one after every <br> and box, so the text is readable */
function isc_mail_lines($html)
{
    return (str_replace(array("<br>", "</div>"), array("<br>\n", "</div>\n"), $html));
}

